generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// --- Core Identity ---

model User {
  id           String      @id @default(cuid())
  employeeId   String      @unique
  email        String      @unique
  name         String
  passwordHash String
  role         String      @default("EMPLOYEE")
  departmentId String?
  managerId    String?
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  lastLoginAt  DateTime?

  department   Department? @relation(fields: [departmentId], references: [id])
  manager      User?       @relation("Reports", fields: [managerId], references: [id])
  reportees    User[]      @relation("Reports")
  goals        Goal[]
  checkIns     CheckIn[]
  auditLogs    AuditLog[]
  notifications Notification[]
}

model Department {
  id        String  @id @default(cuid())
  name      String
  code      String  @unique
  headId    String?
  users     User[]
  kpis      DepartmentKPI[]
}

// --- Goal Engine ---

model Goal {
  id           String     @id @default(cuid())
  userId       String
  cycleId      String
  thrustArea   String
  title        String
  description  String?
  uom          String
  target       Float
  weightage    Float      // must sum to 100 per user per cycle
  deadline     DateTime
  kpiType      String
  status       String     @default("DRAFT")
  isShared     Boolean    @default(false)
  sharedGoalId String?    // if derived from SharedGoal
  lockedAt     DateTime?  // set on approval
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  user         User       @relation(fields: [userId], references: [id])
  cycle        GoalCycle  @relation(fields: [cycleId], references: [id])
  sharedGoal   SharedGoal? @relation(fields: [sharedGoalId], references: [id])
  checkIns     CheckIn[]
  approvals    ApprovalLog[]
  auditLogs    AuditLog[]
}

// --- Cycle Management ---

model GoalCycle {
  id            String      @id @default(cuid())
  name          String      // e.g. "FY 2025-26"
  year          Int
  goalSettingStart  DateTime
  goalSettingEnd    DateTime
  q1Start DateTime
  q1End   DateTime
  q2Start DateTime
  q2End   DateTime
  q3Start DateTime
  q3End   DateTime
  q4Start DateTime
  q4End   DateTime
  isActive      Boolean     @default(false)
  goals         Goal[]
  checkIns      CheckIn[]
}

// --- Check-in Engine ---

model CheckIn {
  id          String      @id @default(cuid())
  goalId      String
  userId      String
  cycleId     String
  quarter     String
  achievement Float
  status      String      @default("NOT_STARTED")
  notes       String?
  managerComment String?
  reviewedAt  DateTime?
  reviewedBy  String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  goal        Goal        @relation(fields: [goalId], references: [id])
  user        User        @relation(fields: [userId], references: [id])
  cycle       GoalCycle   @relation(fields: [cycleId], references: [id])
}

// --- Shared Goals ---

model SharedGoal {
  id          String   @id @default(cuid())
  title       String
  description String?
  target      Float
  uom         String
  kpiType     String
  thrustArea  String
  createdBy   String   // Admin userId
  departmentId String?
  createdAt   DateTime @default(now())
  derivedGoals Goal[]
}

// --- Approval Flow ---

model ApprovalLog {
  id        String        @id @default(cuid())
  goalId    String
  actorId   String
  action    String
  comment   String?
  snapshot  String        // JSON string
  createdAt DateTime      @default(now())

  goal      Goal          @relation(fields: [goalId], references: [id])
}

// --- Audit Trail ---

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  goalId     String?
  entity     String   // "Goal" | "User" | "CheckIn" | "SharedGoal"
  entityId   String
  action     String
  prevValue  String?  // JSON string
  newValue   String?  // JSON string
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  actor      User     @relation(fields: [actorId], references: [id])
  goal       Goal?    @relation(fields: [goalId], references: [id])
}

// --- Notifications ---

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String
  linkPath  String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user      User             @relation(fields: [userId], references: [id])
}

// --- Department KPIs ---

model DepartmentKPI {
  id           String     @id @default(cuid())
  departmentId String
  title        String
  target       Float
  uom          String
  cycleId      String
  department   Department @relation(fields: [departmentId], references: [id])
}
